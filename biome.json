{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "plugins": [
    "/Users/peng.li/.agents/skills/biome/plugins/no-flatmap-as-filter.grit",
    "/Users/peng.li/.agents/skills/biome/plugins/no-setstate-in-effect.grit",
    "/Users/peng.li/.agents/skills/biome/plugins/no-useref-as-state.grit",
    "/Users/peng.li/.agents/skills/biome/plugins/no-deep-relative-import.grit",
    "/Users/peng.li/.agents/skills/biome/plugins/prefer-type-alias.grit"
  ],
  "files": {
    "includes": [
      "**/*.{js,ts,tsx,json}",
      "!dist",
      "!dist-ssr",
      "!generated",
      "!src/web/components/ui",
      "!src/web/components/agent-elements",
      "!src/web/hooks/use-mobile.ts"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDefaultExport": "error",
        "noEnum": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["vite.config.ts", "vitest.config.ts"],
      "linter": {
        "rules": {
          "style": { "noDefaultExport": "off" }
        }
      }
    },
    {
      "includes": ["src/web/lib/next-dynamic.tsx"],
      "linter": {
        "rules": {
          "style": { "noDefaultExport": "off" }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "es5",
      "semicolons": "asNeeded"
    }
  }
}
