{
  "name": "freewind-mac-manager",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "APP_PORT=7409 vite --host --open",
    "build": "tsc --noEmit && vite build && vite build --ssr src/server/main.ts --outDir dist-ssr/server",
    "start": "APP_PORT=7410 node dist-ssr/server/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.104.1",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/express": "^3.52.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "express": "^5.1.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/express": "^5.0.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
