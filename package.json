{
  "name": "freewind-mac-manager",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "pnpm generate:openapi && vite --open",
    "build": "pnpm generate:openapi && pnpm typecheck && vite build && vite build --ssr src/server/main.ts --outDir dist-ssr/server",
    "start": "node dist-ssr/server/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.104.1",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/express": "^3.52.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "express": "^5.1.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.3",
    "shadcn": "^4.21.4",
    "smol-toml": "^1.9.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@ts-rest/open-api": "^3.52.1",
    "@types/express": "^5.0.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "jsdom": "^30.1.2",
    "swagger-ui-dist": "^5.33.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
